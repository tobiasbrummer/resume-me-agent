# Your personal stammdaten. Read by yaml_to_tex.py and merged into every
# application's meta.tex. Edit this once, then per-application meta.yaml only
# needs the recipient + posting fields.
#
# Rename this file to `user.yaml` after editing (and add it to .gitignore if
# the repo will be public; default .gitignore already excludes it).

name:       "Your Name"
adresse:    "Your Street 1"
plz_ort:    "12345 Your City"
tel:        "+49 123 456789"          # any format -- yaml_to_tex.py normalizes to a tel: link
email:      "you@example.com"
github:     "github.com/yourname"     # without the https://
ort:        "Your City"               # used in date line on the cover letter
sprache:    "de"                      # default language for new applications: de | en
grussformel: "Mit freundlichen Grüßen"  # default closing -- per-application meta.yaml can override
